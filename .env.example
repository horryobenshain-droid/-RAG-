APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# demo mode works without any external API key.
# Use local embeddings when your gateway does not provide embedding models.
LLM_PROVIDER=demo
EMBEDDING_PROVIDER=demo

OPENAI_API_KEY=
# Optional: set this for OpenAI-compatible gateway providers.
# Example: https://your-gateway.example.com/v1
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Ollama local chat models. Examples:
#   Qwen:  ollama pull qwen2.5:7b
#   Llama: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1024
OLLAMA_TOP_P=0.9
OLLAMA_REPEAT_PENALTY=1.1
OLLAMA_TIMEOUT_SECONDS=120

LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

CHROMA_COLLECTION=local_rag_knowledge
CHUNK_SIZE=900
CHUNK_OVERLAP=150
DEFAULT_TOP_K=4

# Retrieval candidates and hybrid ranking.
RETRIEVAL_STRATEGY=similarity
RETRIEVAL_FETCH_K=40
MMR_LAMBDA_MULT=0.5
HYBRID_VECTOR_WEIGHT=0.45
HYBRID_KEYWORD_WEIGHT=0.40
HYBRID_FILENAME_WEIGHT=0.10
HYBRID_SYMBOL_WEIGHT=0.05

# Optional second-stage reranker. Enabling it may download the model on first use.
RERANKER_PROVIDER=none
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu
RERANKER_CANDIDATE_K=12
RERANKER_BATCH_SIZE=16
RERANKER_WEIGHT=0.60
