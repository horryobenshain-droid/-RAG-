APP_ENV=production

RAG_AUTH_USER=admin
RAG_BIND_ADDRESS=127.0.0.1
RAG_HTTP_PORT=8080
RAG_MAX_BODY_SIZE=64m

LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=local

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=512
OLLAMA_TOP_P=0.9
OLLAMA_REPEAT_PENALTY=1.1
OLLAMA_TIMEOUT_SECONDS=120

LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

CHROMA_COLLECTION=local_rag_knowledge
CHUNK_SIZE=900
CHUNK_OVERLAP=150
DEFAULT_TOP_K=4
RETRIEVAL_STRATEGY=similarity
RETRIEVAL_FETCH_K=40
MMR_LAMBDA_MULT=0.5
HYBRID_VECTOR_WEIGHT=0.45
HYBRID_KEYWORD_WEIGHT=0.40
HYBRID_FILENAME_WEIGHT=0.10
HYBRID_SYMBOL_WEIGHT=0.05

RERANKER_PROVIDER=none
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu
RERANKER_CANDIDATE_K=12
RERANKER_BATCH_SIZE=16
RERANKER_WEIGHT=0.60

REPOSITORY_MAX_ARCHIVE_BYTES=26214400
REPOSITORY_MAX_FILES=2000
REPOSITORY_MAX_FILE_BYTES=2097152
REPOSITORY_MAX_TOTAL_BYTES=52428800

# FastAPI is private inside Compose. Keep this empty unless another browser client calls it.
CORS_ALLOWED_ORIGINS=
